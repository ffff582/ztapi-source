# Copy to a protected production environment file and replace every placeholder.
# Never commit real credentials.
MYSQL_DATABASE=ztapi
MYSQL_USER=ztapi
MYSQL_PASSWORD=replace_with_a_strong_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_mysql_root_password
REDIS_PASSWORD=replace_with_a_strong_redis_password
ZTAPI_SESSION_SIGNING_KEY=replace_with_at_least_32_random_characters
CRYPTO_SECRET=replace_with_at_least_32_random_characters
ZTAPI_UPSTREAM_MASTER_KEY=replace_with_at_least_32_random_characters
TRONGRID_API_KEY=replace_with_your_trongrid_api_key
ZTAPI_TRUSTED_PROXY_CIDRS=172.30.0.0/24
ZTAPI_DROP_LEGACY_TOKEN_KEY=false
ZTAPI_LEGACY_PAYMENT_ENABLED=false
ZTAPI_TLS_DIR=/absolute/path/to/tls
ZTAPI_RELEASE_VERSION=
ZTAPI_SERVER_IMAGE=sha256:<server-image-id>
ZTAPI_NGINX_IMAGE=sha256:<nginx-image-id>
TZ=Asia/Shanghai
