[Unit]
Description=ZTAPI independent host health watchdog (read-only)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/ztapi-health-watchdog/ztapi-health-watchdog.py
StateDirectory=ztapi-health-watchdog
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45s
TimeoutStopSec=5s
KillMode=control-group
SuccessExitStatus=0 1
Restart=no
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/ztapi-health-watchdog
StandardOutput=journal
StandardError=journal
