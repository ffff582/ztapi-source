FROM golang:1.25.1-alpine AS build

ENV CGO_ENABLED=0 \
    GOOS=linux
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN mkdir -p web/default/dist web/classic/dist \
    && printf '<!doctype html><title>ZTAPI</title>' > web/default/dist/index.html \
    && cp web/default/dist/index.html web/classic/dist/index.html
RUN go build \
    -trimpath \
    -ldflags="-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" \
    -o /out/ztapi \
    .

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S ztapi \
    && adduser -S -G ztapi -h /data ztapi \
    && mkdir -p /data /licenses \
    && chown -R ztapi:ztapi /data

COPY --from=build /out/ztapi /usr/local/bin/ztapi
COPY --from=build /src/LICENSE /src/NOTICE /src/THIRD-PARTY-LICENSES.md /licenses/

ENV GIN_MODE=release \
    PORT=3000
EXPOSE 3000
VOLUME ["/data"]
WORKDIR /data
USER ztapi
ENTRYPOINT ["/usr/local/bin/ztapi"]
